# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OAuth (configure in Supabase Dashboard → Authentication → Providers)
# Google: add Client ID and Client Secret in the Supabase dashboard
# Microsoft: add Client ID and Client Secret in the Supabase dashboard
# No additional backend env vars are needed — OAuth is handled by Supabase Auth

# AI Service
AI_SERVICE_URL=http://localhost:5000

# Server
PORT=3000
# Comma-separate extra origins for phone / LAN testing, e.g.:
# FRONTEND_URL=http://localhost:5173,http://192.168.100.12:5173
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_key

# Module 11 — Registration-time fraud guardrails
FRAUD_MAX_FAILED_ATTEMPTS_PER_IP=3
FRAUD_MAX_FAILED_ATTEMPTS_PER_DEVICE=3
FRAUD_LOOKBACK_HOURS=24
