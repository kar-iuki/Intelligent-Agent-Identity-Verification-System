# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OAuth (configure in Supabase Dashboard → Authentication → Providers)
# Google: add Client ID and Client Secret in the Supabase dashboard
# Microsoft: add Client ID and Client Secret in the Supabase dashboard
# No additional backend env vars are needed — OAuth is handled by Supabase Auth

# AI Service
AI_SERVICE_URL=http://localhost:5000

# Server
PORT=3000

# JWT
JWT_SECRET=your_jwt_secret_key
